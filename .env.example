# Database (RAG for chat + Insights studio HTML posts)
DATABASE_URL=

# Insights studio — /studio/blog (password + optional stronger session secret)
# Demo / meeting: use a simple value locally; set a strong secret in Vercel for production.
CLIENT_STUDIO_PASSWORD=demo-studio-meeting
# Phase 1: any 16+ character string; use the same value locally and on Vercel.
CLIENT_STUDIO_SESSION_SECRET=asbrokers-studio-phase1-session

# Supabase (CRM + Insights studio image uploads). Get from Supabase project Settings > API.
# Studio uploads need URL + service role key; optionally set SUPABASE_BLOG_IMAGES_BUCKET (default: blog-images).
NEXT_PUBLIC_SUPABASE_URL=
# Optional server-only alias if you prefer not to duplicate the project URL as NEXT_PUBLIC_* (service client only).
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BLOG_IMAGES_BUCKET=
# Personal access token (Account → Access Tokens) — for npm run auth:configure only. Never commit.
SUPABASE_ACCESS_TOKEN=

# Google Gemini (chat + RAG embeddings)
GOOGLE_GENERATIVE_AI_API_KEY=

# HubSpot (contact form sync)
HUBSPOT_ACCESS_TOKEN=
# or: HUBSPOT_PRIVATE_APP_TOKEN=

# Trigger.dev (PDF-after-contact; set in Next.js)
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=as-brokers

# WhatsApp Business Cloud API (Meta webhook + outbound)
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# App URL (PDF worker + draft mode) — prefer https://www.asbrokers.co.za so sitemap/metadata match Search Console.
NEXT_PUBLIC_APP_URL=
# Optional override for canonical origin if different from NEXT_PUBLIC_APP_URL (sitemap + JSON-LD).
# NEXT_PUBLIC_SITE_URL=https://www.asbrokers.co.za

# or set APP_URL in Trigger worker env

# Resend (transactional email — contact, newsletter, lead alerts; also Trigger PDF worker)
RESEND_API_KEY=
RESEND_FROM=AS Brokers <albert@asbrokers.co.za>
# Staff inbox for new enquiries / leads (defaults to albert@asbrokers.co.za if unset)
RESEND_NOTIFY_EMAIL=albert@asbrokers.co.za

# Sanity (Phase 3)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3000/studio
SANITY_VIEWER_TOKEN=

# Analytics (Phase 4) – only loaded after "Accept All" cookie consent (POPIA)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_HOTJAR_ID=
